#!/usr/bin/env python3
"""Qualitaetspruefung: leidet die Scout-Extraktion, wenn das Reasoning aus ist?

Hintergrund (21.09.2026): deepseek-v4-flash ist ein Reasoning-Modell. Fuer die
reine Namens-Erkennung im Scout gehen ~90 % der Ausgabe-Tokens ins Reasoning
(490 bis 9.763 Tokens fuer aehnliche Chunks, ~33 Tok/s), ein Call dauert 18 bis
297 s. Mit reasoning={"enabled": false} sind es 3 bis 9 s. Ob dabei Qualitaet
verloren geht, war mit drei Chunks nicht zu sagen — schon zwei Laeufe mit
IDENTISCHER Konfiguration wichen stark voneinander ab.

Aufbau: pro Chunk vier Arme
    REF1, REF2   volles Reasoning (max_tokens 12000), zweimal -> Rauschgrenze
    OFF          Reasoning aus
    MINI         gpt-4o-mini (der bestehende Fallback aus _call_cascade)

Massstab ist NICHT "stimmt mit REF1 ueberein", sondern: weicht ein Arm staerker
von den Referenzen ab, als die beiden Referenzen untereinander abweichen? Fuer
einen Arm X, der aus derselben Verteilung stammt wie die Referenzen, gilt
E[J(X, REF1)] = E[J(REF1, REF2)]. Die Differenz je Chunk, gemittelt und mit
Bootstrap-Konfidenzintervall ueber die Chunks, ist die Kennzahl.

Aufruf:
    python3 scripts/scout_quality_probe.py --limit 2      # Rauchtest
    python3 scripts/scout_quality_probe.py                # voller Lauf (fortsetzbar)
    python3 scripts/scout_quality_probe.py --analyze      # nur auswerten

Schreibt NICHTS in trading.db (read-only) und nicht in llm_budget_log.
Ergebnisse: data/scout_quality_probe.jsonl (eine Zeile je Chunk und Arm).
"""
import argparse
import json
import os
import random
import re
import sqlite3
import statistics
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor

T = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, T)
sys.path.insert(0, os.path.join(T, "scripts"))

OUT = os.path.join(T, "data", "scout_quality_probe.jsonl")
DB = os.path.join(T, "data", "trading.db")
SEED = 42
DEFAULT_N = 64
WORKERS = 8
REQ_TIMEOUT = 420

ARM_ORDER = ["REF1", "REF2", "OFF", "MINI"]


def arm_config(se):
    return {
        "REF1": {"model": se.MODEL, "extra": {"max_tokens": 12000}},
        "REF2": {"model": se.MODEL, "extra": {"max_tokens": 12000}},
        "OFF":  {"model": se.MODEL,
                 "extra": {"max_tokens": 4000, "reasoning": {"enabled": False}}},
        "MINI": {"model": se.FALLBACK_MODEL, "extra": {"max_tokens": 4000}},
    }


# ─────────────────────────────────────────────────────────── Namensabgleich
_STOP = {"inc", "corp", "corporation", "co", "company", "ag", "se", "plc", "ltd",
         "limited", "holdings", "holding", "group", "class", "a", "b", "c", "the",
         "sa", "nv", "llc", "lp", "and"}


def _tokens(name):
    n = (name or "").lower().replace("&", " and ")
    n = re.sub(r"[^\w\s]", " ", n)
    toks = [t for t in n.split() if t]
    core = [t for t in toks if t not in _STOP]
    return frozenset(core or toks)


def match_count(a_names, b_names):
    """Anzahl 1:1-Treffer; ein Name trifft, wenn eine Tokenmenge Teilmenge der anderen ist."""
    b_tok = [_tokens(x) for x in b_names]
    used = set()
    hits = []
    for i, an in enumerate(a_names):
        at = _tokens(an)
        if not at:
            continue
        for j, bt in enumerate(b_tok):
            if j in used or not bt:
                continue
            if at <= bt or bt <= at:
                used.add(j)
                hits.append((i, j))
                break
    return hits


def jaccard(a_names, b_names):
    if not a_names and not b_names:
        return 1.0
    m = len(match_count(a_names, b_names))
    return m / (len(a_names) + len(b_names) - m)


# ───────────────────────────────────────────────────────────── Datenauswahl
def pick_chunks(se, n):
    con = sqlite3.connect("file:" + DB + "?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    rows = con.execute(
        "SELECT video_id, channel, title, upload_date, transcript FROM videos "
        "WHERE transcript IS NOT NULL AND created_at >= datetime('now','-7 days') "
        "ORDER BY video_id").fetchall()
    con.close()
    rows = list(rows)
    random.Random(SEED).shuffle(rows)          # stabile Reihenfolge: --limit ist ein Praefix
    out = []
    for r in rows[:n]:
        chunks = se._chunk_transcript(r["transcript"])
        if not chunks:
            continue
        rng = random.Random("%s-%s" % (SEED, r["video_id"]))
        idx = rng.randrange(len(chunks))
        out.append({"chunk_id": "%s#%d" % (r["video_id"], idx),
                    "channel": r["channel"], "title": r["title"],
                    "date": r["upload_date"], "num": idx + 1, "total": len(chunks),
                    "text": chunks[idx]})
    return out


# ───────────────────────────────────────────────────────────────── Aufruf
_LOCK = threading.Lock()


def call_arm(se, requests, key, chunk, arm, cfg):
    user = ("Kanal: %s\nTitel: %s\nDatum: %s\nTranskript-Abschnitt %d/%d:\n\n%s"
            % (chunk["channel"], chunk["title"], chunk["date"],
               chunk["num"], chunk["total"], chunk["text"]))
    payload = {"model": cfg["model"],
               "messages": [{"role": "system", "content": se.SCOUT_PROMPT},
                            {"role": "user", "content": user}],
               "usage": {"include": True}}
    payload.update(cfg["extra"])
    rec = {"chunk_id": chunk["chunk_id"], "arm": arm, "chars": len(chunk["text"])}
    t0 = time.time()
    resp = None
    for attempt in range(1, 4):
        try:
            resp = requests.post(
                "https://openrouter.ai/api/v1/chat/completions",
                headers={"Authorization": "Bearer " + key,
                         "Content-Type": "application/json"},
                json=payload, timeout=REQ_TIMEOUT)
        except Exception as exc:                       # Netzwerk/Timeout
            rec["error"] = "%s: %s" % (type(exc).__name__, str(exc)[:80])
            time.sleep(2 ** attempt)
            continue
        if resp.status_code == 400 and "usage" in resp.text.lower() and "usage" in payload:
            payload.pop("usage")                       # Parameter nicht unterstuetzt
            continue
        if resp.status_code == 429 or 500 <= resp.status_code < 600:
            rec["error"] = "HTTP %d" % resp.status_code
            time.sleep(2 ** attempt)
            continue
        break
    rec["dt"] = round(time.time() - t0, 1)
    if resp is None or resp.status_code != 200:
        rec["parse"] = "http_fail"
        rec.setdefault("error", "HTTP %s" % (resp.status_code if resp is not None else "-"))
        return rec
    rec.pop("error", None)
    d = resp.json()
    ch = d["choices"][0]
    u = d.get("usage", {}) or {}
    det = u.get("completion_tokens_details", {}) or {}
    rec.update({"finish": ch.get("finish_reason"),
                "tok_in": u.get("prompt_tokens"), "tok_out": u.get("completion_tokens"),
                "reasoning": det.get("reasoning_tokens"), "cost": u.get("cost")})
    content = (ch.get("message", {}) or {}).get("content")
    if not content:
        rec["parse"] = "empty"
        return rec
    try:
        parsed = se._try_parse(content.strip())
    except json.JSONDecodeError:
        rec["parse"] = "json_fail"
        return rec
    if not isinstance(parsed, dict) or "companies" not in parsed:
        rec["parse"] = "wrong_shape"
        return rec
    rec["parse"] = "ok"
    rec["companies"] = [{"name": (c.get("name") or "").strip(),
                         "sent": (c.get("rough_sentiment") or "").lower()}
                        for c in (parsed.get("companies") or []) if (c.get("name") or "").strip()]
    rec["outlook"] = (parsed.get("market_outlook") or "").lower()
    return rec


def run(limit):
    import env_loader  # noqa: F401
    import requests
    import signal_extractor as se

    key = os.environ["OPENROUTER_API_KEY"]
    cfgs = arm_config(se)
    chunks = pick_chunks(se, limit)
    done = set()
    if os.path.exists(OUT):
        for line in open(OUT, encoding="utf-8"):
            try:
                r = json.loads(line)
                done.add((r["chunk_id"], r["arm"]))
            except Exception:
                continue
    jobs = [(c, a) for c in chunks for a in ARM_ORDER if (c["chunk_id"], a) not in done]
    print("Chunks: %d | Jobs offen: %d (bereits vorhanden: %d) | Worker: %d"
          % (len(chunks), len(jobs), len(done), WORKERS), flush=True)
    counter = {"n": 0}

    def work(job):
        chunk, arm = job
        rec = call_arm(se, requests, key, chunk, arm, cfgs[arm])
        with _LOCK:
            with open(OUT, "a", encoding="utf-8") as fh:
                fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
            counter["n"] += 1
            print("[%3d/%d] %-22s %-5s %-9s %6.0fs  reasoning=%s"
                  % (counter["n"], len(jobs), chunk["chunk_id"][:22], arm,
                     rec.get("parse"), rec.get("dt", 0), rec.get("reasoning")),
                  flush=True)

    # Lange Referenz-Calls zuerst einsortieren, damit der Long-Tail nicht am Ende haengt
    jobs.sort(key=lambda j: 0 if j[1].startswith("REF") else 1)
    with ThreadPoolExecutor(max_workers=WORKERS) as ex:
        list(ex.map(work, jobs))
    print("Lauf beendet.", flush=True)


# ─────────────────────────────────────────────────────────────── Auswertung
def bootstrap_ci(values, n=2000, seed=11):
    rnd = random.Random(seed)
    means = sorted(statistics.mean(rnd.choices(values, k=len(values))) for _ in range(n))
    return means[int(n * 0.025)], means[int(n * 0.975)]


def analyze():
    recs = {}
    for line in open(OUT, encoding="utf-8"):
        r = json.loads(line)
        recs.setdefault(r["chunk_id"], {})[r["arm"]] = r

    total = len(recs)
    usable, dropped = [], {}
    for cid, arms in recs.items():
        why = None
        for a in ARM_ORDER:
            r = arms.get(a)
            if r is None:
                why = "Arm %s fehlt" % a
                break
            if r.get("parse") != "ok":
                why = "%s: %s%s" % (a, r.get("parse"),
                                    " (finish=%s)" % r.get("finish") if r.get("finish") else "")
                break
        if why:
            dropped[cid] = why
        else:
            usable.append(cid)

    print("=== Datenbasis ===")
    print("  Chunks gesamt: %d | vollstaendig auswertbar: %d | ausgeschlossen: %d"
          % (total, len(usable), len(dropped)))
    for cid, why in list(dropped.items())[:8]:
        print("     ausgeschlossen: %-24s %s" % (cid[:24], why))
    if len(usable) < 10:
        print("  Zu wenige Chunks fuer eine belastbare Aussage.")
        if not usable:
            return

    def names(cid, arm):
        return [c["name"] for c in recs[cid][arm]["companies"]]

    print("\n=== Ausbeute und Kosten je Arm ===")
    print("  %-6s %9s %9s %9s %10s %10s %10s"
          % ("Arm", "Firmen/Ch", "Chunks>0", "Zeit med", "Zeit max", "reasoning", "Kosten $"))
    for a in ARM_ORDER:
        cnt = [len(names(c, a)) for c in usable]
        dts = [recs[c][a]["dt"] for c in usable]
        rt = [recs[c][a].get("reasoning") or 0 for c in usable]
        cost = [recs[c][a].get("cost") for c in recs if a in recs[c]
                and recs[c][a].get("cost") is not None]
        print("  %-6s %9.2f %9d %8.0fs %9.0fs %10.0f %10s"
              % (a, statistics.mean(cnt), sum(1 for x in cnt if x > 0),
                 statistics.median(dts), max(dts), statistics.mean(rt),
                 ("%.3f" % sum(cost)) if cost else "n/a"))

    # Referenz-Rauschen je Chunk
    j_ref = {c: jaccard(names(c, "REF1"), names(c, "REF2")) for c in usable}
    informative = [c for c in usable if names(c, "REF1") or names(c, "REF2")]
    print("\n=== Rauschgrenze: zwei Laeufe mit IDENTISCHER Konfiguration (REF1 vs REF2) ===")
    print("  Jaccard alle Chunks       : %.3f  (n=%d)" % (statistics.mean(j_ref.values()), len(usable)))
    if informative:
        print("  Jaccard nur Chunks mit Treffer: %.3f  (n=%d)"
              % (statistics.mean(j_ref[c] for c in informative), len(informative)))

    print("\n=== Weicht ein Arm staerker von den Referenzen ab als die Referenzen untereinander? ===")
    print("  Kennzahl d = mittlere J(Arm, REF1/REF2) minus J(REF1, REF2), je Chunk; 0 = nicht unterscheidbar")
    print("  %-6s %-22s %8s   %-18s %s" % ("Arm", "Menge", "d", "95%-KI", "Urteil"))
    for a in ("OFF", "MINI"):
        for label, pool in (("alle Chunks", usable), ("nur mit Treffer", informative)):
            if len(pool) < 5:
                continue
            d = [(jaccard(names(c, a), names(c, "REF1")) + jaccard(names(c, a), names(c, "REF2"))) / 2
                 - j_ref[c] for c in pool]
            lo, hi = bootstrap_ci(d)
            verdict = ("kein messbarer Unterschied" if lo <= 0 <= hi
                       else ("SCHLECHTER als Referenz-Rauschen" if hi < 0 else "uebereinstimmender als Rauschen"))
            print("  %-6s %-22s %+8.3f   [%+.3f, %+.3f]    %s"
                  % (a, "%s (n=%d)" % (label, len(pool)), statistics.mean(d), lo, hi, verdict))

    print("\n=== Trefferquote (Recall) gegen die Vereinigung beider Referenzen ===")
    for a in ("OFF", "MINI", "REF1", "REF2"):
        rec_v = []
        for c in informative:
            if a in ("REF1", "REF2"):
                other = "REF2" if a == "REF1" else "REF1"
                ref_names = names(c, other)                 # gegen den ANDEREN Referenzlauf
            else:
                ref_names = names(c, "REF1") + [n for n in names(c, "REF2")
                                                if not match_count([n], names(c, "REF1"))]
            if ref_names:
                rec_v.append(len(match_count(ref_names, names(c, a))) / len(ref_names))
        if rec_v:
            lbl = {"REF1": "REF1 gg. REF2", "REF2": "REF2 gg. REF1"}.get(a, a + " gg. REF-Vereinigung")
            print("  %-24s Recall %.3f  (n=%d Chunks mit Referenztreffern)"
                  % (lbl, statistics.mean(rec_v), len(rec_v)))

    print("\n=== Sentiment-Uebereinstimmung auf gemeinsam gefundenen Firmen ===")
    for a in ("REF2", "OFF", "MINI"):
        agree = tot = 0
        for c in usable:
            an, bn = recs[c][a]["companies"], recs[c]["REF1"]["companies"]
            for i, j in match_count([x["name"] for x in an], [x["name"] for x in bn]):
                tot += 1
                agree += an[i]["sent"] == bn[j]["sent"]
        if tot:
            print("  %-6s gg. REF1: %.3f  (%d gemeinsame Firmen)" % (a, agree / tot, tot))

    print("\n=== Marktausblick (market_outlook) gleich wie REF1 ===")
    for a in ("REF2", "OFF", "MINI"):
        same = sum(1 for c in usable if recs[c][a].get("outlook") == recs[c]["REF1"].get("outlook"))
        print("  %-6s %d/%d" % (a, same, len(usable)))

    fin = {}
    for c in recs:
        for a, r in recs[c].items():
            if a.startswith("REF") and r.get("finish") == "length":
                fin[a] = fin.get(a, 0) + 1
    if fin:
        print("\n  Hinweis: Referenzlaeufe mit finish_reason=length (auch bei 12000 Tokens): %s" % fin)


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("--limit", type=int, default=DEFAULT_N)
    ap.add_argument("--analyze", action="store_true")
    args = ap.parse_args()
    if args.analyze:
        analyze()
    else:
        run(args.limit)
