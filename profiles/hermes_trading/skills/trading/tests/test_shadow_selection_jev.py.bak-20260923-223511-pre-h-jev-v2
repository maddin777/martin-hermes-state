def test_switch_defaults_to_off_and_unknown_values_mean_off(monkeypatch):
    assert ss._jev_enabled() is False
    for v in ("on", " ON ", "On"):
        monkeypatch.setenv("JEV_SHADOW", v)
        assert ss._jev_enabled() is True
    for v in ("", "1", "true", "yes", "an", "quatsch"):
        monkeypatch.setenv("JEV_SHADOW", v)
        assert ss._jev_enabled() is False


