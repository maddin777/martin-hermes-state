def _stopout_trade():
    bars = [{"high": 100, "low": 100, "close": 100}, {"high": 101, "low": 80, "close": 85}] + \
           [{"high": 90, "low": 84, "close": 88}] * 8
    return {"_bars": bars, "_entry_idx": 0, "_atr": 2.0, "entry_price": 100.0, "direction": "LONG",
            "asset_type": "STANDARD", "position_size": 1000.0}


@pytest.mark.parametrize("module", [so])
def test_optimizer_replay_uses_the_switch(module):
    trade = _stopout_trade()
    with mock.patch.object(module, "load_config", return_value={"partial_tp_enabled": False}):
        base = module.backtest_params([trade], "current", 5)[0]["pnl_pct"]
    with mock.patch.object(module, "load_config",
                           return_value={"partial_tp_enabled": False, "stop_slippage_atr": 0.35}):
        slip = module.backtest_params([trade], "current", 5)[0]["pnl_pct"]
    assert base - slip == pytest.approx(0.35 * 2.0 / 100.0 * 100, abs=0.01)     # 0,35 ATR = 0,7 % vom Entry


def test_backtester_replay_uses_the_switch():
    from scripts import backtester as bt
    trade = _stopout_trade()
    with mock.patch.object(bt, "load_config", return_value={"partial_tp_enabled": False}):
        base = bt.backtest_params([trade], "current", 5)[0]["pnl_pct"]
    with mock.patch.object(bt, "load_config",
                           return_value={"partial_tp_enabled": False, "stop_slippage_atr": 0.35}):
        slip = bt.backtest_params([trade], "current", 5)[0]["pnl_pct"]
    assert base > slip


