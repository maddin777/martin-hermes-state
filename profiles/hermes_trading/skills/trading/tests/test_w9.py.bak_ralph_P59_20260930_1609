# ── Donchian / 5 Tage im Crabel-Shadow ───────────────────────────────────────────────────────
def _b(h, l, c):
    return {"high": h, "low": l, "close": c}


def _live(bars, cfg, entry_idx=0, direction="LONG", sl=96.0):
    base = {"donchian_exit_enabled": True, "donchian_exit_mode": "primary", "donchian_exit_period": 10,
            "time_stop_trading_days": 5, "partial_tp_enabled": False}
    base.update(cfg)
    return cse.simulate_forward_live(bars, entry_idx, 100.0, sl, 2.0, direction, "STANDARD", base)


def test_live_replay_uses_the_configured_time_stop_not_seven_days():
    bars = [_b(100, 100, 100)] + [_b(101, 99, 100)] * 9
    outcome, px, days = _live(bars, {})
    assert outcome == "TIME_STOP" and days == 5 and px == pytest.approx(100.0)


def test_live_replay_stop_hit_fills_at_the_stop_and_with_slippage_below():
    bars = [_b(100, 100, 100), _b(100, 99, 99.5), _b(99, 95, 96)] + [_b(97, 96, 96)] * 4
    outcome, px, days = _live(bars, {})
    assert (outcome, days) == ("SL_HIT", 2) and px == pytest.approx(96.0)
    outcome, px, days = _live(bars, {"stop_slippage_atr": 0.35})
    assert px == pytest.approx(96.0 - 0.7)


def test_live_replay_donchian_trail_uses_history_before_the_entry():
    hist = [_b(103, 97.5, 101)] * 10                        # Vorgeschichte: Tiefs bei 97,5
    fwd = [_b(105, 101, 104), _b(106, 103, 105), _b(105, 96.9, 97)]
    bars = hist + [_b(101, 99, 100)] + fwd                  # Entry bei Index 10
    outcome, px, days = _live(bars, {}, entry_idx=10, sl=96.0)
    # Trail zieht auf das 10-Bar-Tief (>= 97,5) hoch, der Stop wird am 3. Tag gerissen — deutlich ueber dem Anfangs-Stop 96
    assert outcome == "SL_HIT" and px > 96.5


def test_live_replay_short_direction_is_mirrored():
    bars = [_b(100, 100, 100), _b(105, 99, 104)] + [_b(104, 103, 104)] * 4
    outcome, px, days = _live(bars, {}, direction="SHORT", sl=104.0)
    assert outcome == "SL_HIT" and px == pytest.approx(104.0)


def test_live_replay_none_without_usable_levels():
    assert _live([_b(100, 100, 100)] * 4, {}, sl=100.0) is None


def test_old_chandelier_simulation_is_still_available_and_switchable():
