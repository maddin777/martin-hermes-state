# ── N10: Sektor-Sperrliste ───────────────────────────────────────────────────────────────────
def _db():
    con = sqlite3.connect(":memory:")
    con.row_factory = sqlite3.Row
    con.execute("CREATE TABLE watchlist (id INTEGER PRIMARY KEY, ticker TEXT, status TEXT, conviction_score REAL)")
    sm.init_db(con)
    con.execute("CREATE TABLE IF NOT EXISTS companies (ticker TEXT PRIMARY KEY, name TEXT, sector TEXT)")
    con.commit()
    return con


def _closed(con, ticker, sector, pnl, days_ago=2, exit_date=None):
    con.execute("INSERT OR IGNORE INTO companies (ticker, name, sector) VALUES (?,?,?)", (ticker, ticker, sector))
    ed = exit_date or (datetime.now() - timedelta(days=days_ago)).isoformat()
    cur = con.execute(
        "INSERT INTO positions (ticker, name, direction, entry_price, entry_date, position_size, status, "
        "exit_date, pnl_eur, pnl_pct) VALUES (?,?,?,?,?,?,?,?,?,?)",
        (ticker, ticker, "LONG", 100.0, ed, 1000.0, "closed", ed, pnl, pnl / 10))
    con.commit()
    return cur.lastrowid


def _losing_sector(con, sector="Energy", n=3):
    for i in range(n):
        _closed(con, f"{sector[:3].upper()}{i}", sector, -20.0)


def _rows(con):
    return {r["sector"]: dict(r) for r in con.execute("SELECT * FROM sector_blacklist")}


def test_losing_sector_lands_in_the_db_and_not_in_the_json_config():
    con, cfg = _db(), {"sector_cooldown_days": 14, "sector_blacklist": {}}
    _losing_sector(con)
    cfg = sm.update_sector_blacklist(con, cfg)
    rows = _rows(con)
    assert "Energy" in rows and rows["Energy"]["blocked_at"] == datetime.now().strftime("%Y-%m-%d")
    assert rows["Energy"]["cooldown_days"] == 14 and "3 Trades" in rows["Energy"]["reason"]
    assert cfg["sector_blacklist"] == {}          # nichts mehr in der JSON-Config, die der Nachtlauf leert


def test_block_survives_the_nightly_json_cleanup_and_does_not_restart_each_run():
    con, cfg = _db(), {"sector_cooldown_days": 14, "sector_blacklist": {}}
    _losing_sector(con)
    sm.update_sector_blacklist(con, cfg)
    con.execute("UPDATE sector_blacklist SET blocked_at=? WHERE sector='Energy'",
                ((datetime.now() - timedelta(days=5)).strftime("%Y-%m-%d"),))
    con.commit()
    sm.update_sector_blacklist(con, cfg)               # naechster stuendlicher Lauf
    assert _rows(con)["Energy"]["blocked_at"] == (datetime.now() - timedelta(days=5)).strftime("%Y-%m-%d")
    ok, prob, why = sm.is_sector_allowed("Energy", con, cfg)
    assert ok is False and prob is False and "5/14d" in why


def test_unlisted_sector_is_allowed():
    con, cfg = _db(), {"sector_cooldown_days": 14}
    assert sm.is_sector_allowed("Technology", con, cfg) == (True, False, "")


def test_sector_with_fewer_than_three_trades_or_positive_pnl_is_not_blocked():
    con, cfg = _db(), {"sector_cooldown_days": 14}
    _closed(con, "A1", "Utilities", -20.0)
    _closed(con, "A2", "Utilities", -20.0)
    for i in range(3):
        _closed(con, f"B{i}", "Technology", 30.0)
    sm.update_sector_blacklist(con, cfg)
    assert _rows(con) == {}


