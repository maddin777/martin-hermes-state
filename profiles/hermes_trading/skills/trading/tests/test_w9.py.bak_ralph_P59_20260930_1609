def test_legacy_json_entries_are_imported_once_with_their_real_date():
    con = _db()
    since = (datetime.now() - timedelta(days=3)).isoformat()
    cfg = {"sector_cooldown_days": 14,
           "sector_blacklist": {"Energy": {"blocked_since": since, "reason": "alt", "probation_done": False}}}
    _losing_sector(con)
    with mock.patch.object(sm, "save_config") as save:
        cfg = sm.update_sector_blacklist(con, cfg)
    row = _rows(con)["Energy"]
    assert row["blocked_at"] == since[:10] and row["reason"] == "alt"
    assert cfg["sector_blacklist"] == {} and save.called


def test_probation_window_opens_after_the_cooldown_and_takes_a_single_trade():
    con, cfg = _db(), {"sector_cooldown_days": 14, "sector_probation_size_pct": 0.5}
    sm._ensure_sector_table(con)
    old = (datetime.now() - timedelta(days=15)).strftime("%Y-%m-%d")
    con.execute("INSERT INTO sector_blacklist (sector, blocked_at, cooldown_days) VALUES ('Energy', ?, 14)", (old,))
    con.commit()
    ok, prob, _ = sm.is_sector_allowed("Energy", con, cfg)
    assert ok and prob
    pid = _closed(con, "XOM", "Energy", 0.0)
    con.execute("UPDATE positions SET status='open', exit_date=NULL, pnl_eur=NULL WHERE id=?", (pid,))
    sm.mark_probation_started(con, "Energy", "XOM", pid)
    row = _rows(con)["Energy"]
    assert row["probation_status"] == "active" and row["probation_entry_ticker"] == "XOM"
    ok, prob, why = sm.is_sector_allowed("Energy", con, cfg)        # Probation-Trade laeuft noch
    assert ok is False and "laeuft" in why
    assert _rows(con)["Energy"]["probation_status"] == "active"     # kein vorschneller Fehlschlag


def _probation_case(pnl, threshold=0):
    con, cfg = _db(), {"sector_cooldown_days": 14, "sector_reentry_threshold_pnl": threshold}
    sm._ensure_sector_table(con)
    old = (datetime.now() - timedelta(days=15)).strftime("%Y-%m-%d")
    con.execute("INSERT INTO sector_blacklist (sector, blocked_at, cooldown_days) VALUES ('Energy', ?, 14)", (old,))
    con.commit()
    pid = _closed(con, "XOM", "Energy", pnl, days_ago=0)
    sm.mark_probation_started(con, "Energy", "XOM", pid)
    return con, cfg, sm.is_sector_allowed("Energy", con, cfg)


def test_successful_probation_releases_the_sector():
    con, cfg, res = _probation_case(pnl=25.0)
    assert res[0] is True and res[1] is False
    assert _rows(con) == {}


def test_failed_probation_restarts_the_cooldown():
    con, cfg, res = _probation_case(pnl=-10.0)
    assert res[0] is False and "Probation fehlgeschlagen" in res[2]
    row = _rows(con)["Energy"]
    assert row["probation_status"] == "failed" and row["blocked_at"] == datetime.now().strftime("%Y-%m-%d")


def test_reentry_threshold_from_config_is_used():
    con, cfg, res = _probation_case(pnl=5.0, threshold=10.0)         # Gewinn, aber unter der Schwelle
    assert res[0] is False
    assert _rows(con)["Energy"]["probation_status"] == "failed"


def test_nightly_json_migration_maps_blocked_since_and_reason():
