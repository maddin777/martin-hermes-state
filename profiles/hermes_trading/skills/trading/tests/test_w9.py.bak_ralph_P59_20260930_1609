# ── Optimizer: nur Vorschlag, Live-Config nur mit optimizer_apply_live ────────────────────────
def _eval_db(avg_sl=0.8):
    con = sqlite3.connect(":memory:")
    con.execute("""CREATE TABLE eval_metrics (date TEXT, metric_type TEXT, win_rate_7d REAL, profit_factor_7d REAL,
                   exit_sl_pct REAL, exit_tp_pct REAL)""")
    con.execute("INSERT INTO eval_metrics VALUES (?, 'daily', 0.4, 0.9, ?, 0.0)",
                (datetime.now().strftime("%Y-%m-%d"), avg_sl))
    return con


def test_optimizer_only_proposes_the_wider_profile_by_default():
    cfg, changes = so.adjust_from_eval_metrics(_eval_db(), {"exit_profile": "current"})
    assert cfg["exit_profile"] == "current"
    assert any("Vorschlag" in c and "nicht angewendet" in c for c in changes)


def test_optimizer_applies_the_profile_when_explicitly_enabled():
    cfg, changes = so.adjust_from_eval_metrics(_eval_db(), {"exit_profile": "current", "optimizer_apply_live": True})
    assert cfg["exit_profile"] != "current"
    assert any("Exit-Profil:" in c for c in changes)


def test_apply_exit_params_gate():
    off, on = {"exit_profile": "current", "time_stop_trading_days": 5}, {"optimizer_apply_live": True}
    assert so.apply_exit_params(off, "wider_stop", 7) is False
    assert off == {"exit_profile": "current", "time_stop_trading_days": 5}
    on.update(off)
    assert so.apply_exit_params(on, "wider_stop", 7) is True
    assert on["exit_profile"] == "wider_stop" and on["time_stop_trading_days"] == 7


